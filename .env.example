# ── Data Provider ─────────────────────────────────────────────────────────────
# Options: "mock" | "supabase"
DATA_PROVIDER=supabase

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side only, never expose to client
# Get from: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Facebook OAuth ────────────────────────────────────────────────────────────
# Get from: https://developers.facebook.com → My Apps → Settings → Basic
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ── Site URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://plcvietnam.vercel.app
NEXT_PUBLIC_BASE_URL=https://plcvietnam.vercel.app

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────────────────
# Optional — falls back to in-memory limiter in development
# Get from: https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── CAPTCHA (Cloudflare Turnstile) ────────────────────────────────────────────
# Optional but recommended for auth abuse protection in production
# Get from: https://dash.cloudflare.com → Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
